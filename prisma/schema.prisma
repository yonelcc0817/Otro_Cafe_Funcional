generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id    Int     @id @default(autoincrement())
  nombre String  @unique
  usuarios Usuario[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String?   @unique
  telefono  String?   @unique
  passwordHash  String
  activo    Boolean  @default(true)
  rolId     Int
  imagen    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rol       Rol    @relation(fields: [rolId], references: [id]) 
}

  enum      EstadoMesa {
    disponible
    ocupada
  }

model Mesa {
  id        Int      @id @default(autoincrement())
  nombre    String   
  codigoQR  String   @unique
  estado    EstadoMesa   @default(disponible)
  pedidos   Pedido[]
  capacidad Int?
}

  enum      EstadoPedido {
    abierto
    cerrado
  }
  enum      TipoPago {
    efectivo
    transferencia
    mixto
  }
model Pedido {
  id        Int      @id @default(autoincrement())
  numero_diario Int?
  mesaId    Int
  estado    EstadoPedido   @default(abierto)
  productos Json
  total     Float    @default(0)
  tipo_pago TipoPago? 
  cant_efect Float?
  cant_transf Float?
  cant_prop   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turnoId   Int?
  
  mesa      Mesa     @relation(fields: [mesaId], references: [id])
  turno     Turno?   @relation(fields: [turnoId], references: [id])
  consumos  PedidoConsumo[]
}

// Consumo real de existencias de un pedido, desglosado por producto base.
// Permite devolver exactamente lo descontado al editar o eliminar el pedido,
// aunque las dependencias del catálogo hayan cambiado después (RF-34 a RF-37).
model PedidoConsumo {
  pedidoId   Int
  productoId Int
  cantidad   Int

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@id([pedidoId, productoId])
}

enum TurnoEstado {
  abierto
  cerrado
}

model Turno {
  id                Int       @id @default(autoincrement())
  numero            Int
  fecha             DateTime
  estado            TurnoEstado @default(abierto)
  iniciadoEn        DateTime  @default(now())
  cerradoEn         DateTime?
  resumen           Json?
  trabajadoresActivos Json?
  pedidos           Pedido[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Categoria {
  id         Int        @id @default(autoincrement())
  nombre     String     
  position   Int?
  habilitada Boolean @default(true)
  productos  Producto[]
}

model Producto {
  id         Int      @id @default(autoincrement())
  nombre     String
  description String?
  precio     Float
  disponible Boolean  @default(true)
  destacado   Boolean @default(false)
  // Existencias en baja disponibilidad: null = venta sin límite,
  // 0 = agotado (oculto del menú), N > 0 = quedan N unidades.
  stock      Int?
  imagen     String?
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  // Dependencias dirigidas: este producto depende de productos base.
  dependencias ProductoDependencia[] @relation("DependeDe")
  // Productos que dependen de este (solo lectura para la gestión).
  dependientes ProductoDependencia[] @relation("EsBaseDe")
}

// Vínculo dirigido dependiente -> base. Solo se admite un nivel: el producto
// base no puede tener dependencias propias. La restricción de clave foránea
// impide borrar un producto del que otros dependen (RF-43).
model ProductoDependencia {
  dependienteId Int
  baseId        Int
  createdAt     DateTime @default(now())

  dependiente Producto @relation("DependeDe", fields: [dependienteId], references: [id], onDelete: Cascade)
  base        Producto @relation("EsBaseDe", fields: [baseId], references: [id], onDelete: Restrict)

  @@id([dependienteId, baseId])
  @@index([baseId])
}

model IdempotencyRecord {
  operationId String   @id
  fingerprint String
  guestFingerprint String?
  statusCode  Int      @default(102)
  response    Json?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
